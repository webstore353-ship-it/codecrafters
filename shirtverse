    </div>

    <!-- BACK TO TOP -->
    <button class="back-to-top" id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        ↑
    </button>

    <script>
        // Products Data
        const products = [
            {
                id: 1,
                name: "Classic White Oxford",
                price: 69.99,
                img: "https://hips.hearstapps.com/hmg-prod/images/mhl-whitedressshirts-charlestyrwhitt-757-1-68dd2beb0c59e.jpg?crop=0.6666666666666667xw:1xh;center,top&resize=1200:*",
                category: "dress",
                desc: "Premium Egyptian cotton. Timeless elegance."
            },
            {
                id: 2,
                name: "Navy Pinstripe Power",
                price: 74.99,
                img: "https://i.ebayimg.com/images/g/uy0AAOSwwItkssvZ/s-l1200.jpg",
                category: "dress",
                desc: "Crisp Italian fabric with subtle pinstripes."
            },
            {
                id: 3,
                name: "Abercrombie Muscle Stripe",
                price: 79.00,
                img: "https://i.ebayimg.com/images/g/YewAAOSwaAllnwoA/s-l1200.jpg",
                category: "casual",
                desc: "Modern athletic fit with premium detailing."
            },
            {
                id: 4,
                name: "Black Graphic Essential",
                price: 49.99,
                img: "https://m.media-amazon.com/images/I/611q3PaE7eL._AC_UY1000_.jpg",
                category: "tee",
                desc: "Bold streetwear print on ultra-soft cotton."
            },
            {
                id: 5,
                name: "Predator Graphic Tee",
                price: 54.99,
                img: "https://i.ebayimg.com/images/g/XGoAAOSwW71nBUJG/s-l1200.jpg",
                category: "tee",
                desc: "High-contrast artistic statement piece."
            },
            {
                id: 6,
                name: "Light Wash Denim Shirt",
                price: 78.00,
                img: "https://m.media-amazon.com/images/I/61-4559-gJL._AC_UY1000_.jpg",
                category: "casual",
                desc: "Comfort stretch denim for everyday wear."
            },
            {
                id: 7,
                name: "Luxury Navy Polo",
                price: 89.99,
                img: "https://i.ebayimg.com/images/g/I74AAOSwnBBl1ki~/s-l1200.jpg",
                category: "polo",
                desc: "Textured Italian cotton. Timeless."
            },
            {
                id: 8,
                name: "Elite Navy Polo Premium",
                price: 99.00,
                img: "https://www.dhresource.com/webp/m/0x0/f2/albu/g9/M00/AC/B7/rBVaVVxW9_2ARoc4AAED5l3d3ak386.jpg",
                category: "polo",
                desc: "Hand-finished luxury blend."
            },
            {
                id: 9,
                name: "Red Lumberjack Flannel",
                price: 74.99,
                img: "https://i.ebayimg.com/images/g/tIUAAOSwiqRk6R1Y/s-l1200.jpg",
                category: "flannel",
                desc: "Ultra-soft brushed cotton."
            },
            {
                id: 10,
                name: "Forest Green Plaid",
                price: 76.00,
                img: "https://m.media-amazon.com/images/S/aplus-media-library-service-media/b122bc2e-2962-4f50-8d49-9fef9c5c0c66.__CR0,0,800,600_PT0_SX800_V1___.jpg",
                category: "flannel",
                desc: "Perfect for any season."
            },
            {
                id: 11,
                name: "Midnight Black Oxford",
                price: 72.99,
                img: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80",
                category: "dress",
                desc: "Sophisticated and versatile."
            },
            {
                id: 12,
                name: "Oversized Cream Tee",
                price: 52.99,
                img: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80",
                category: "tee",
                desc: "Relaxed luxury fit."
            }
        ];

        let cart = [];

        // Render Products
        function renderProducts(filteredProducts) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';
            
            filteredProducts.forEach(product => {
                const cardHTML = `
                    <div class="product-card animate-on-scroll" data-category="${product.category}">
                        <div class="card-inner">
                            <div class="card-front">
                                <img src="${product.img}" alt="${product.name}">
                                <div class="product-info">
                                    <h3>${product.name}</h3>
                                    <p class="price">$${product.price.toFixed(2)}</p>
                                </div>
                            </div>
                            <div class="card-back">
                                <h3>${product.name}</h3>
                                <p>${product.desc}</p>
                                <p class="price">$${product.price.toFixed(2)}</p>
                                <div style="display:flex;gap:12px;">
                                    <button class="add-to-cart" onclick="addToCart(${product.id});event.stopImmediatePropagation()">Add to Cart</button>
                                    <button class="quick-view" onclick="quickView(${product.id});event.stopImmediatePropagation()">Quick View</button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHTML;
            });
        }

        // Filter
        function setupFilters() {
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    buttons.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    
                    const filter = btn.getAttribute('data-filter');
                    let filtered = products;
                    
                    if (filter !== 'all') {
                        filtered = products.filter(p => p.category === filter);
                    }
                    renderProducts(filtered);
                });
            });
        }

        // Add to Cart
        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const existing = cart.find(item => item.id === id);
            
            if (existing) {
                existing.quantity = (existing.quantity || 1) + 1;
            } else {
                cart.push({...product, quantity: 1});
            }
            
            updateCartCount();
            showAddedToast(product.name);
        }

        function updateCartCount() {
            const count = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
            document.getElementById('cart-count').textContent = count;
            document.getElementById('drawer-count').textContent = count;
        }

        function showAddedToast(name) {
            const toast = document.createElement('div');
            toast.style.position = 'fixed';
            toast.style.bottom = '30px';
            toast.style.left = '50%';
            toast.style.transform = 'translateX(-50%)';
            toast.style.background = 'var(--teal)';
            toast.style.color = '#000';
            toast.style.padding = '1rem 2.5rem';
            toast.style.borderRadius = '60px';
            toast.style.fontWeight = '700';
            toast.style.boxShadow = '0 20px 40px rgba(0,245,212,0.4)';
            toast.style.zIndex = '6000';
            toast.style.whiteSpace = 'nowrap';
            toast.textContent = `${name} added to cart ✓`;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.transition = 'all 0.4s';
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(30px)';
                setTimeout(() => toast.remove(), 400);
            }, 2200);
        }

        // Cart Drawer
        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('open');
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            container.innerHTML = '';
            
            if (cart.length === 0) {
                container.innerHTML = `<p style="text-align:center;padding:4rem 1rem;opacity:0.6;">Your cart is empty</p>`;
                document.getElementById('cart-total').textContent = '$0.00';
                return;
            }
            
            let total = 0;
            
            cart.forEach((item, index) => {
                const qty = item.quantity || 1;
                const itemTotal = item.price * qty;
                total += itemTotal;
                
                const itemHTML = `
                    <div style="display:flex;gap:1.5rem;margin-bottom:2rem;padding-bottom:2rem;border-bottom:1px solid rgba(255,255,255,0.1);">
                        <img src="${item.img}" style="width:90px;height:90px;object-fit:cover;border-radius:12px;">
                        <div style="flex:1;">
                            <h4>${item.name}</h4>
                            <p style="opacity:0.7;margin:0.4rem 0;">$${item.price.toFixed(2)} × ${qty}</p>
                            <div style="display:flex;gap:1rem;margin-top:1rem;">
                                <button onclick="changeQty(${index}, -1)" style="background:none;border:1px solid #fff;color:#fff;width:32px;height:32px;border-radius:50%;">−</button>
                                <span style="align-self:center;font-weight:700;">${qty}</span>
                                <button onclick="changeQty(${index}, 1)" style="background:none;border:1px solid #fff;color:#fff;width:32px;height:32px;border-radius:50%;">+</button>
                                <button onclick="removeFromCart(${index})" style="margin-left:auto;color:#e94560;">Remove</button>
                            </div>
                        </div>
                        <div style="text-align:right;font-weight:700;">$${(itemTotal).toFixed(2)}</div>
                    </div>
                `;
                container.innerHTML += itemHTML;
            });
            
            document.getElementById('cart-total').textContent = `$${total.toFixed(2)}`;
        }

        function changeQty(index, change) {
            cart[index].quantity = (cart[index].quantity || 1) + change;
            if (cart[index].quantity < 1) cart[index].quantity = 1;
            renderCart();
            updateCartCount();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
            updateCartCount();
        }

        function checkout() {
            if (cart.length === 0) return;
            alert("🎉 Thank you! This would redirect to a secure checkout in a real store.");
            cart = [];
            updateCartCount();
            toggleCart();
        }

        // Quick View Modal (simple alert version for brevity)
        function quickView(id) {
            const product = products.find(p => p.id === id);
            alert(`Quick View:\n\n${product.name}\n$${product.price.toFixed(2)}\n\n${product.desc}\n\n(Full modal would appear here in production)`);
        }

        // Testimonial Carousel
        let currentSlide = 0;
        const slideWidth = 100;
        
        function moveTestimonial() {
            const track = document.getElementById('testimonial-track');
            track.style.transform = `translateX(-${currentSlide * slideWidth}%)`;
        }
        
        function nextTestimonial() {
            currentSlide = (currentSlide + 1) % 3;
            moveTestimonial();
        }
        
        function prevTestimonial() {
            currentSlide = (currentSlide - 1 + 3) % 3;
            moveTestimonial();
        }

        // Scroll animations
        function observeAnimations() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });
            
            document.querySelectorAll('.animate-on-scroll').forEach(el => {
                observer.observe(el);
            });
        }

        // Header scroll effect
        function headerScroll() {
            const header = document.getElementById('header');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 80) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });
        }

        // Back to top
        function backToTop() {
            const btn = document.getElementById('back-to-top');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 600) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            });
        }

        // Mobile menu
        function setupMobileMenu() {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            
            btn.addEventListener('click', () => {
                menu.classList.toggle('active');
                btn.innerHTML = menu.classList.contains('active') ? 
                    '<i class="fas fa-times"></i>' : '<i class="fas fa-bars"></i>';
            });
        }

        // Newsletter
        function setupNewsletter() {
            const form = document.getElementById('newsletter-form');
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const input = form.querySelector('input');
                if (input.value.trim()) {
                    alert("✅ Welcome to the Inner Circle! Check your email for your 20% off code.");
                    input.value = '';
                }
            });
        }

        // Initialize everything
        document.addEventListener('DOMContentLoaded', () => {
            // Render all products initially
            renderProducts(products);
            
            setupFilters();
            observeAnimations();
            headerScroll();
            backToTop();
            setupMobileMenu();
            setupNewsletter();
            
            // Auto slide testimonials
            setInterval(() => {
                nextTestimonial();
            }, 5200);
            
            // Keyboard escape for cart
            document.addEventListener('keydown', (e) => {
                if (e.key === "Escape") {
                    const drawer = document.getElementById('cart-drawer');
                    if (drawer.classList.contains('open')) toggleCart();
                }
            });
            
            // Demo: add one item to cart on load
            // setTimeout(() => { addToCart(1); }, 1800);
        });
    </script>
