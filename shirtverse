        <div id="cart-items" style="flex:1;overflow-y:auto;"></div>
        <div style="border-top:1px solid rgba(255,255,255,0.2);padding-top:2rem;">
            <div style="display:flex;justify-content:space-between;font-size:1.4rem;margin-bottom:1.5rem;">
                <span>Total</span>
                <span id="cart-total">$0.00</span>
            </div>
            <button onclick="checkout()" style="width:100%;padding:1.4rem;background:var(--gradient-accent);color:#000;font-size:1.3rem;font-weight:700;border:none;border-radius:60px;cursor:pointer;">CHECKOUT SECURELY</button>
